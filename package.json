{
  "name": "my-agent",
  "version": "0.1.0",
  "scripts": {
    "start":          "PROVIDER=deepseek ts-node src/index.ts",
    "start:deepseek": "PROVIDER=deepseek ts-node src/index.ts",
    "start:gemini":   "PROVIDER=gemini ts-node src/index.ts",
    "start:lmstudio": "PROVIDER=lmstudio ts-node src/index.ts",
    "bench":                   "PROVIDER=deepseek ts-node bench/run.ts",
    "bench:deepseek":          "PROVIDER=deepseek ts-node bench/run.ts",
    "bench:gemini":            "PROVIDER=gemini ts-node bench/run.ts",
    "bench:lmstudio":          "PROVIDER=lmstudio ts-node bench/run.ts",
    "bench:strategies":        "PROVIDER=deepseek ts-node bench/run-strategies.ts",
    "bench:strategies:gemini": "PROVIDER=gemini ts-node bench/run-strategies.ts",
    "bench:strategies:lm":     "PROVIDER=lmstudio ts-node bench/run-strategies.ts",
    "bench:memory":            "PROVIDER=deepseek ts-node bench/run-memory.ts",
    "bench:memory:gemini":     "PROVIDER=gemini ts-node bench/run-memory.ts",
    "bench:memory:lm":         "PROVIDER=lmstudio ts-node bench/run-memory.ts",
    "watch-memory":            "npx ts-node bench/watch-memory.ts",
    "memory:clear":            "node -e \"const fs=require('fs');fs.writeFileSync('memory/ltm.json','[]');fs.writeFileSync('memory/ltm-log.jsonl','');fs.writeFileSync('memory/wm-state.json','{}');console.log('LTM cleared.')\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
