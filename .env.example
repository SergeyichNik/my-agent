# Select provider via npm script:
#   npm run start:deepseek
#   npm run start:gemini
#   npm run start:lmstudio

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# LM Studio (local)
# LMSTUDIO_BASE_URL=http://localhost:1234
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_CONTEXT_SIZE=32768

# SESSIONS_DIR=./sessions

# Context management (summarization)
# SUMMARY_ENABLED=true
# SUMMARY_BATCH_SIZE=10
# SUMMARY_TAIL=6

# Benchmark — judge is an independent agent, can use a different provider than the main agent
# BENCH_JUDGE_PROVIDER=deepseek    # deepseek | gemini | lmstudio (default: same as PROVIDER)
# BENCH_JUDGE_MODEL=deepseek-reasoner
#
# Example: agent = LM Studio (local), judge = DeepSeek Reasoner (API)
#   PROVIDER=lmstudio
#   BENCH_JUDGE_PROVIDER=deepseek
#   BENCH_JUDGE_MODEL=deepseek-reasoner
#   DEEPSEEK_API_KEY=sk-...        ← add this even if PROVIDER=lmstudio
